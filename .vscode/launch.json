{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Arc Extension (no build)",
      "type": "node",
      "request": "attach",
      "timeout": 30000,
      "address": "127.0.0.1",
      "port": 5874,
      "restart": false,
      "outFiles": [
        "${workspaceFolder}/packages/arc/dist/**/*.js"
      ],
      "preLaunchTask": "start:arc-debug-host",
      "presentation": {
        "reveal": "auto"
      }
    },
    {
      "name": "Run Arc Extension",
      "type": "node",
      "request": "attach",
      "timeout": 30000,
      "address": "127.0.0.1",
      "port": 5874,
      "restart": false,
      "outFiles": [
        "${workspaceFolder}/packages/arc/dist/**/*.js"
      ],
      "preLaunchTask": "build:ext + start:arc-debug-host",
      "presentation": {
        "reveal": "auto"
      }
    },
    {
      "name": "Run Arc Extension (watch + reload)",
      "type": "node",
      "request": "attach",
      "timeout": 30000,
      "address": "127.0.0.1",
      "port": 5874,
      "restart": false,
      "outFiles": [
        "${workspaceFolder}/packages/arc/dist/**/*.js"
      ],
      "preLaunchTask": "build:ext + start:arc-debug-host",
      "presentation": {
        "reveal": "auto"
      }
    },
    {
      "name": "Arc: Run @arc/host tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@arc/host",
        "test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "reveal": "always" }
    },
    {
      "name": "Arc: Run all tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "reveal": "always" }
    },
    {
      "name": "Arc: Package .vsix",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "arc",
        "package"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "reveal": "always" }
    }
  ],
  "compounds": [
    {
      "name": "Arc: Build + Launch",
      "configurations": ["Run Arc Extension"]
    }
  ]
}
