{
  "name": "@arc/host",
  "version": "0.7.3",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "require": "./dist/protocol/index.cjs"
    },
    "./catalog": {
      "types": "./dist/providers/catalog.d.ts",
      "import": "./dist/providers/catalog.js",
      "require": "./dist/providers/catalog.cjs"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js",
      "require": "./dist/util/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.5.4",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "playwright": "1.55.1"
  }
}
