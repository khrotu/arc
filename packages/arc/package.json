{
  "name": "arc-code",
  "displayName": "Arc",
  "description": "0.28 MB provider-agnostic agentic harness. 262+ providers with tiered model routing, multi-provider failover, and first-class security.",
  "version": "0.7.3",
  "publisher": "khrotu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/khrotu/arc"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.0.0"
  },
  "main": "dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Arc loads repository instructions and exposes privileged coding tools, so it requires explicit Workspace Trust."
    }
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Machine Learning"
  ],
  "keywords": [
    "ai coding agent",
    "model router",
    "multi-model",
    "mcp",
    "subagent",
    "playwright"
  ],
  "icon": "assets/arc-logo-mono.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "assets/arc-logo-mono.png",
    "assets/arc-logo-mono.svg",
    "assets/arc-logo-mono-text.svg",
    "assets/arc-logo-pride.svg",
    "LICENSE*",
    "package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc-activitybar",
          "title": "Arc",
          "icon": "assets/arc-logo-mono.svg",
          "when": "!arc.isPrideMonth"
        },
        {
          "id": "arc-activitybar-pride",
          "title": "Arc",
          "icon": "assets/arc-logo-pride.svg",
          "when": "arc.isPrideMonth"
        }
      ]
    },
    "views": {
      "arc-activitybar": [
        {
          "type": "webview",
          "id": "arc-sidebar",
          "name": "Arc",
          "icon": "assets/arc-logo-mono.svg",
          "contextualTitle": "Arc",
          "when": "!arc.isPrideMonth"
        }
      ],
      "arc-activitybar-pride": [
        {
          "type": "webview",
          "id": "arc-sidebar-pride",
          "name": "Arc",
          "icon": "assets/arc-logo-pride.svg",
          "contextualTitle": "Arc",
          "when": "arc.isPrideMonth"
        }
      ]
    },
    "commands": [
      {
        "command": "arc.openSidebar",
        "title": "Open Sidebar Chat",
        "category": "Arc"
      },
      {
        "command": "arc.openFullscreen",
        "title": "Open Full-Screen Chat",
        "category": "Arc",
        "icon": "$(screen-full)"
      },
      {
        "command": "arc.openSettings",
        "title": "Open Settings",
        "category": "Arc",
        "icon": "$(gear)"
      },
      {
        "command": "arc.notebook.generate",
        "title": "Generate Notebook Cell",
        "category": "Arc"
      },
      {
        "command": "arc.notebook.explain",
        "title": "Explain Notebook Cell",
        "category": "Arc"
      },
      {
        "command": "arc.notebook.improve",
        "title": "Improve Notebook Cell",
        "category": "Arc"
      },
      {
        "command": "arc.newTask",
        "title": "New Task",
        "category": "Arc"
      },
      {
        "command": "arc.stop",
        "title": "Stop Current Task",
        "category": "Arc"
      },
      {
        "command": "arc.continue",
        "title": "Continue Last Task",
        "category": "Arc"
      },
      {
        "command": "arc.toggleProblems",
        "title": "Toggle Problems Panel",
        "category": "Arc"
      },
      {
        "command": "arc.manageModels",
        "title": "Manage Models",
        "category": "Arc"
      },
      {
        "command": "arc.manageMcp",
        "title": "Manage MCP Servers",
        "category": "Arc"
      },
      {
        "command": "arc.managePrompts",
        "title": "Manage System Prompts",
        "category": "Arc"
      },
      {
        "command": "arc.auditLog.export",
        "title": "Export Audit Log",
        "category": "Arc"
      },
      {
        "command": "arc.auditLog.verify",
        "title": "Verify Audit Log",
        "category": "Arc"
      },
      {
        "command": "arc.explainSelection",
        "title": "Explain with Arc",
        "category": "Arc"
      },
      {
        "command": "arc.fixSelection",
        "title": "Fix with Arc",
        "category": "Arc"
      },
      {
        "command": "arc.inlineChat",
        "title": "Inline Chat",
        "category": "Arc"
      },
      {
        "command": "arc.inlineChat.submit",
        "title": "Send to Arc",
        "category": "Arc",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "arc.inlineChat.cancel",
        "title": "Discard",
        "category": "Arc",
        "icon": "$(trash)"
      },
      {
        "command": "arc.inlineChat.pickModel",
        "title": "Switch Model",
        "category": "Arc",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "arc.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Arc",
        "icon": "$(git-commit)"
      },
      {
        "command": "arc.security.scanDiff",
        "title": "Scan Diff for Secrets",
        "category": "Arc"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arc.openFullscreen",
          "when": "view == arc-sidebar || view == arc-sidebar-pride",
          "group": "navigation@1"
        },
        {
          "command": "arc.openSettings",
          "when": "view == arc-sidebar || view == arc-sidebar-pride",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "arc.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "arc.explainSelection",
          "when": "editorHasSelection",
          "group": "arc@1"
        },
        {
          "command": "arc.fixSelection",
          "when": "editorHasSelection",
          "group": "arc@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "arc.inlineChat.submit",
          "group": "inline",
          "when": "commentController == arc.inlineChat"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "arc.inlineChat.cancel",
          "group": "navigation",
          "when": "commentController == arc.inlineChat"
        }
      ],
      "comments/comment/title": [
        {
          "command": "arc.inlineChat.pickModel",
          "group": "navigation",
          "when": "commentController == arc.inlineChat && comment == arcModelHeader"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "arc.notebook.generate",
          "group": "arc@1",
          "when": "notebookEditorFocused"
        },
        {
          "command": "arc.notebook.explain",
          "group": "arc@2",
          "when": "notebookEditorFocused"
        },
        {
          "command": "arc.notebook.improve",
          "group": "arc@3",
          "when": "notebookEditorFocused"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arc.openSidebar",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "arc.openFullscreen",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "arc.openSettings",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,"
      },
      {
        "command": "arc.newTask",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "arc.inlineChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Arc",
      "properties": {
        "arc.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show OS notifications on specific events."
        },
        "arc.shell.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ls",
            "dir",
            "cat",
            "type",
            "cp",
            "copy",
            "mv",
            "move",
            "rm",
            "del",
            "mkdir",
            "rmdir",
            "grep",
            "rg",
            "find",
            "findstr",
            "sed",
            "awk",
            "diff",
            "git",
            "gh",
            "pnpm",
            "npm",
            "yarn",
            "npx",
            "node",
            "python",
            "pip",
            "go",
            "cargo",
            "rustc",
            "make",
            "gcc",
            "g++",
            "curl",
            "wget",
            "tar",
            "zip",
            "unzip",
            "ssh",
            "docker",
            "kubectl",
            "tsc",
            "eslint",
            "prettier",
            "jest",
            "vitest",
            "esbuild",
            "vite",
            "pwsh",
            "powershell",
            "Get-ChildItem",
            "Get-Content",
            "Set-Content",
            "New-Item",
            "Remove-Item",
            "Copy-Item",
            "Move-Item",
            "Test-Path",
            "Select-String",
            "Invoke-WebRequest",
            "echo",
            "cd",
            "tasklist",
            "taskkill",
            "netstat",
            "ping",
            "ipconfig",
            "whoami"
          ],
          "description": "Commands that can run without explicit approval when shell.approval is 'allowlist'."
        },
        "arc.security.promptInjection": {
          "type": "string",
          "enum": [
            "off",
            "balanced",
            "strict"
          ],
          "default": "balanced",
          "description": "How much to enforce prompt-injection protection."
        },
        "arc.sandbox.profile": {
          "type": "string",
          "enum": [
            "off",
            "read-only",
            "workspace",
            "system"
          ],
          "default": "off",
          "description": "Native shell sandbox profile."
        },
        "arc.shell.terminal": {
          "type": "string",
          "default": "default",
          "description": "Terminal used to run shell commands."
        },
        "arc.shell.surface": {
          "type": "string",
          "enum": [
            "arc-handled",
            "integrated"
          ],
          "enumDescriptions": [
            "Arc runs the command as a hidden process: output streams into the chat, timeouts adopt it into the background, and the sandbox applies.",
            "Runs in a visible integrated terminal titled 'Arc': output is captured via shell integration and the sandbox does not apply."
          ],
          "default": "arc-handled",
          "description": "Where shell tool commands run."
        },
        "arc.compaction.strategy": {
          "type": "string",
          "enum": [
            "model-aware",
            "fixed"
          ],
          "default": "model-aware",
          "description": "Context compaction strategy. Model-aware never compacts before half the usable window."
        },
        "arc.compaction.fixedAtPct": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "Fixed strategy only: compact once the context reaches this percentage of the model's context window."
        },
        "arc.compaction.safetyMargin": {
          "type": "number",
          "default": 0.15,
          "description": "Model-aware strategy only: extra fraction of the window kept free below the learned output reserve before compacting."
        },
        "arc.compaction.frictionCost": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "User-friction penalty per compaction in dollars (F) used by the cost-optimal compaction timing. 0 means purely cost-minimizing."
        },
        "arc.compaction.lostContextPenalty": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Lost-context penalty per discarded token in dollars (beta) used by the cost-optimal compaction timing. Higher values compact sooner."
        },
        "arc.verify.mode": {
          "type": "string",
          "enum": [
            "none",
            "default",
            "custom"
          ],
          "enumDescriptions": [
            "Never run post-edit verification commands, even if ~/.arc/workspaces/<workspace>/verify.toml defines them.",
            "Use the retry count defined in ~/.arc/workspaces/<workspace>/verify.toml (falls back to 3 if unset).",
            "Override the retry count with arc.verify.customMaxRetries."
          ],
          "default": "default",
          "description": "Controls how post-edit verification retries on failure."
        },
        "arc.verify.customMaxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Number of retry attempts for post-edit verification when arc.verify.mode is 'custom'."
        },
        "arc.search.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic code search."
        },
        "arc.search.backend": {
          "type": "string",
          "enum": [
            "hash-based",
            "semantic"
          ],
          "default": "hash-based",
          "description": "Embedding backend."
        },
        "arc.search.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openrouter"
          ],
          "default": "ollama",
          "description": "Embedding model provider for the semantic backend."
        },
        "arc.search.openrouterModel": {
          "type": "string",
          "default": "openai/text-embedding-3-small",
          "description": "Default OpenRouter embedding model."
        },
        "arc.search.modelTier": {
          "type": "string",
          "enum": [
            "low",
            "mid",
            "high"
          ],
          "default": "low",
          "description": "Embedding model tier for the Ollama provider."
        },
        "arc.search.ollamaUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama base URL for the semantic embedding backend."
        },
        "arc.indexing.autoWatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically keep the semantic search index up to date."
        },
        "arc.search.autoReindex": {
          "type": "string",
          "enum": [
            "off",
            "hourly",
            "daily"
          ],
          "default": "off",
          "description": "Periodically trigger a full workspace reindex on a schedule, in addition to the live IndexWatcher."
        },
        "arc.titleGeneration.method": {
          "type": "string",
          "scope": "machine",
          "default": "first-words",
          "description": "Method for generating chat titles."
        },
        "arc.promptPolish": {
          "type": "string",
          "enum": [
            "off",
            "basic",
            "polish"
          ],
          "default": "off",
          "description": "Polish prompts before sending."
        },
        "arc.router.quality": {
          "type": "string",
          "enum": [
            "balanced",
            "economy",
            "power"
          ],
          "default": "balanced",
          "description": "Auto-model routing quality."
        },
        "arc.router.autoRoute": {
          "type": "boolean",
          "default": false,
          "description": "When using the Auto model, skip the routed-model confirmation and send the message directly to the chosen model."
        },
        "arc.router.modelUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/KHROTU/arc/main/packages/arc/resources/router/difficulty.json",
          "description": "URL of the Auto router difficulty model."
        },
        "arc.model.multimodalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of model IDs that support multimodal input."
        },
        "arc.image.describeModel": {
          "type": "string",
          "default": "none",
          "description": "Model used to describe attached images when the active model isn't multimodal."
        },
        "arc.image.ollamaUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama endpoint used for image description."
        },
        "arc.proxy.url": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Fallback proxy URL used when a category-specific proxy is not set."
        },
        "arc.proxy.providerUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Proxy URL for model provider API calls."
        },
        "arc.proxy.webUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Proxy URL for web.fetch and web.search tools."
        },
        "arc.proxy.shellUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Proxy URL for shell commands."
        },
        "arc.appearance.prideLogo": {
          "type": "string",
          "enum": [
            "always",
            "june",
            "never"
          ],
          "default": "june",
          "description": "When to show the pride logo."
        },
        "arc.appearance.toolTree": {
          "type": "string",
          "enum": [
            "auto",
            "collapsed"
          ],
          "default": "auto",
          "description": "How tool call trees display."
        },
        "arc.appearance.toolGroupSummary": {
          "type": "string",
          "enum": [
            "count",
            "tools",
            "ai"
          ],
          "default": "count",
          "description": "How a finished tool-call chain is shown."
        },
        "arc.appearance.fontFamily": {
          "type": "string",
          "enum": [
            "inter",
            "atkinson",
            "quicksand",
            "geist-sans",
            "custom"
          ],
          "default": "atkinson",
          "description": "UI font for the chat interface."
        },
        "arc.appearance.monoFontFamily": {
          "type": "string",
          "enum": [
            "jetbrains-mono",
            "ibm-plex-mono",
            "fira-code",
            "geist-mono",
            "custom"
          ],
          "default": "ibm-plex-mono",
          "description": "Monospace font for code blocks and tool output."
        },
        "arc.appearance.customFontFamily": {
          "type": "string",
          "default": "",
          "description": "Custom font family. Add your own self-hosted @font-face or system font here."
        },
        "arc.appearance.customMonoFontFamily": {
          "type": "string",
          "default": "",
          "description": "Custom font family. Add your own self-hosted @font-face or system font here."
        },
        "arc.diffView.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open a diff editor in the main window while the agent edits a file."
        },
        "arc.showProblems": {
          "type": "boolean",
          "default": false,
          "description": "Show the Problems panel with LSP diagnostics for files the agent edits."
        },
        "arc.tools.disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "shell.customRun",
            "shell.editCustomRun",
            "shell.runCustomRun",
            "browser.drag",
            "browser.evaluate",
            "browser.hover",
            "browser.domSnapshot",
            "browser.readPage",
            "browser.newTab",
            "browser.closeTab",
            "browser.switchTab",
            "browser.listTabs",
            "git.stage",
            "git.commit",
            "git.push",
            "git.branch",
            "git.branchDiff",
            "git.changedFiles",
            "git.commitMessage",
            "git.diffStaged",
            "git.diffUnstaged",
            "git.pr",
            "notebook.read",
            "notebook.execute",
            "notebook.editCell",
            "notebook.addCell",
            "notebook.deleteCell",
            "test.run",
            "session.exportTrace"
          ],
          "description": "Tool calls the main agent is not allowed to use. Fresh installs start with the curated default set."
        },
        "arc.discord.spoofRpc": {
          "type": "boolean",
          "default": false,
          "description": "Show the file the agent is actively editing as your Discord presence."
        },
        "arc.reasoning.effort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high",
          "description": "Default reasoning effort level used when starting a new chat."
        },
        "arc.outputStyle": {
          "type": "string",
          "default": "default",
          "description": "Output style appended to the system prompt."
        },
        "arc.compaction.customPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional custom context-compression prompt template used instead of the built-in one when Arc compacts history."
        },
        "arc.memory.teamStores": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra MEMORY.md files merged into memory.list under a '(team)' category, for org-wide conventions."
        },
        "arc.memory.autoNotes": {
          "type": "boolean",
          "default": true,
          "description": "Automatically append a short summary note to the workspace's agent-facing notes when a task finishes."
        },
        "arc.attention.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Play short attention sounds on specific events."
        },
        "arc.attention.volume": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "Attention sound volume (0-100)."
        },
        "arc.attention.completion": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when a task/turn completes."
        },
        "arc.attention.approval": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when Arc asks for approval."
        },
        "arc.attention.error": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when a turn fails."
        },
        "arc.attention.sound": {
          "type": "string",
          "enum": [
            "beep",
            "system",
            "pop"
          ],
          "default": "beep",
          "description": "Attention sound style."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "arc.welcome",
        "title": "Arc",
        "description": "Get Arc set up: add a model, pick a tier, run your first task.",
        "steps": [
          {
            "id": "arc.welcome.open",
            "title": "Open Arc",
            "description": "Click the Arc icon in the activity bar.",
            "command": "arc.openSidebar"
          },
          {
            "id": "arc.welcome.model",
            "title": "Add a model",
            "description": "Open Arc settings to add at least one model and provider.",
            "command": "arc.manageModels"
          },
          {
            "id": "arc.welcome.run",
            "title": "Run a task",
            "description": "Ask Arc to do something in the chat."
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@arc/host": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "terser": "5.51.0",
    "vitest": "4.1.10"
  }
}
