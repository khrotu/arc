{
  "name": "arc-workspace",
  "private": true,
  "version": "0.7.3",
  "description": "Arc monorepo root",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter @arc/host build && pnpm --filter arc-code build",
    "build:webview": "pnpm --filter @arc/webview build",
    "watch": "pnpm -r --parallel build --watch",
    "test": "pnpm -r test",
    "package": "node scripts/package-ext.mjs",
    "clean": "pnpm -r exec rm -rf dist out *.vsix",
    "prod": "npm run prod:clean",
    "prod:clean": "node scripts/remove-comments.mjs && node scripts/remove-blank-lines.mjs",
    "prod:size": "node scripts/size-eval.mjs",
    "prod:full": "node scripts/remove-comments.mjs && node scripts/remove-blank-lines.mjs && node scripts/size-eval.mjs",
    "prod:ver": "node scripts/change-ver.mjs"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.18.0",
    "@types/vscode": "1.95.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "glob": "^13.0.6",
    "playwright": "1.62.0",
    "sharp": "^0.35.4",
    "typescript": "5.5.4",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  }
}
